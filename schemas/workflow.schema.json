{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cut-motion Workflow State",
  "type": "object",
  "required": ["schemaVersion", "jobId", "mode", "coverReviewDecision", "roughCutReviewDecision", "captionMode", "captionModeSource", "captionModeAcknowledged", "visualAxisMode", "visualAxisModeSource", "visualAxisModeAcknowledged", "referenceScriptStatus", "referenceScriptAcknowledged", "referenceScriptPath", "referenceScriptSha256", "reconciliationReturnState", "creativeConfirmationSha256", "creativeDocumentFingerprints", "authoritativeMediaPath", "authoritativeMediaSha256", "sourceTranscriptSha256", "trimPlanSha256", "visualPlanSha256", "compositionArtifactPath", "compositionArtifactSha256", "revisionId", "currentState", "pendingGate", "completed", "gates", "history"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "jobId": { "type": "string" },
    "mode": { "enum": ["review", "auto"] },
    "coverReviewDecision": { "enum": ["pending", "approved"] },
    "roughCutReviewDecision": { "enum": ["pending", "manual-approved", "automatic-fallback"] },
    "visualArrangementReviewRequired": { "const": true },
    "visualArrangementReviewDecision": { "enum": ["pending", "manual-approved", "automatic-accepted"] },
    "roughCutSelectionPolicy": { "enum": [null, "reference-aligned-last-complete-take-v1"] },
    "roughCutSelectionPolicyOrigin": { "enum": [null, "reference-aligned-last-complete-take-v1"] },
    "roughCutSelectionFallbackWaiver": {
      "type": ["object", "null"],
      "required": ["actor", "waivedAt", "reason"],
      "properties": {
        "actor": { "const": "user" },
        "waivedAt": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "captionMode": { "enum": ["motion-copy", "subtitles"] },
    "captionModeSource": { "enum": ["default", "user", "auto"] },
    "captionModeAcknowledged": { "type": "boolean" },
    "visualAxisMode": { "enum": ["a-axis-overlay", "b-axis-stage", "hybrid"] },
    "visualAxisModeSource": { "enum": ["default", "user", "auto"] },
    "visualAxisModeAcknowledged": { "type": "boolean" },
    "referenceScriptStatus": { "enum": ["unknown", "none", "provided"] },
    "referenceScriptAcknowledged": { "type": "boolean" },
    "referenceScriptPath": { "type": ["string", "null"] },
    "referenceScriptSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "reconciliationReturnState": { "enum": [null, "rough-cut", "motion-plan"] },
    "creativeConfirmationSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "creativeDocumentFingerprints": { "type": ["object", "null"] },
    "authoritativeMediaPath": { "type": ["string", "null"] },
    "authoritativeMediaSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "sourceTranscriptSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "trimPlanSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "visualPlanSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "compositionArtifactPath": { "type": ["string", "null"] },
    "compositionArtifactSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "lastKnownGoodDelivery": {
      "type": ["object", "null"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "validatedAt": { "type": "string", "minLength": 1 }
      },
      "required": ["path", "sha256", "validatedAt"]
    },
    "revisionId": { "type": "integer", "minimum": 1 },
    "currentState": {
      "enum": ["intake", "transcription", "rough-cut", "rough-cut-review", "rough-cut-export", "motion-plan", "visual-arrangement-review", "composition", "render", "complete"]
    },
    "pendingGate": { "enum": [null, "rough-cut-review", "visual-arrangement-review"] },
    "completed": { "type": "boolean" },
    "createdAt": { "type": ["string", "null"] },
    "updatedAt": { "type": ["string", "null"] },
    "gates": {
      "type": "object",
      "properties": {
        "rough-cut-review": { "type": "object" },
        "visual-arrangement-review": { "type": "object" }
      },
      "additionalProperties": false
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "action", "actor", "from", "to"],
        "properties": {
          "at": { "type": "string" },
          "action": { "type": "string" },
          "actor": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "artifact": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "visualArrangementReviewRequired": { "const": true } },
        "required": ["visualArrangementReviewRequired"]
      },
      "then": { "required": ["visualArrangementReviewDecision"] }
    }
  ],
  "additionalProperties": false
}
